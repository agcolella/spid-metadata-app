# ============================================
# CONFIGURAZIONE BACKEND - ESEMPIO
# ============================================
# Copia questo file in .env e inserisci i tuoi valori

# Porta server (default: 4000)
PORT=4000

# Ambiente (development/production)
NODE_ENV=development

# ============================================
# GITHUB CONFIGURATION
# ============================================

# Token GitHub (richiesto)
# Genera un Personal Access Token su: https://github.com/settings/tokens
# Permessi richiesti: repo (tutti), workflow
GITHUB_TOKEN=ghp_your_github_token_here

# Repository target (formato: owner/repository-name)
GITHUB_REPO=your-username/your-repo-name

# Branch base per le PR (default: main)
BASE_BRANCH=main

# Prefisso per i branch delle PR (default: spid-batch-)
BRANCH_PREFIX=spid-batch-

# ============================================
# VALIDAZIONE XML
# ============================================

# Abilita validazione XML (true/false, default: true)
VALIDATION_ENABLED=true

# Modalità strict: blocca upload se ci sono errori (true/false, default: false)
VALIDATION_STRICT_MODE=false

# ============================================
# LIMITI & PERFORMANCE
# ============================================

# Numero massimo di file per PR (default: 50)
MAX_FILES_PER_PR=50

# Concorrenza upload file (1-10, default: 5)
UPLOAD_CONCURRENCY=5

# ============================================
# FRONTEND URL (opzionale)
# ============================================

# URL del frontend per CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000
